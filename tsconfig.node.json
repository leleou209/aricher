{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./.tsbuild/node.tsbuildinfo",
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./.tsbuild/node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true
  },
  "include": ["src", "test", "worker-configuration.d.ts", "vite.config.ts"]
}
